# HTTP port
PORT=3000

# API version; every route is served under /v{API_VERSION}
API_VERSION=1

# DEVELOPMENT or DEPLOYMENT
ENVIRONMENT=DEVELOPMENT

# Access token signing secret and lifetime
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRE=1d
# Refresh token signing secret and lifetime
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=yoora_vpn
